{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DB Sonde",
  "version": "0.51.22",
  "identifier": "com.u35.dbsonde",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DB Sonde",
        "width": 1320,
        "height": 840,
        "minWidth": 920,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) 2026 DB Sonde contributors",
    "licenseFile": "../LICENSE"
  }
}
