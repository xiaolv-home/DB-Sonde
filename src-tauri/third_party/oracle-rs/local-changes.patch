+/// Strip leading whitespace and `--` / `/* */` comments (sonde local change).
+fn skip_leading_comments(mut sql: &str) -> &str {
+    loop {
+        let t = sql.trim_start();
+        if let Some(rest) = t.strip_prefix("--") {
+            match rest.find('\n') {
+                Some(i) => sql = &rest[i + 1..],
+                None => return "",
+            }
+        } else if let Some(rest) = t.strip_prefix("/*") {
+            match rest.find("*/") {
+                Some(i) => sql = &rest[i + 2..],
+                None => return "",
+            }
+        } else {
+            return t;
+        }
+    }
+}
